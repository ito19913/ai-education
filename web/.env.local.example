# 実際の値を入れた .env.local を web/ 直下に作成して使う（.gitignore で除外済み）
# このファイルはテンプレートとして git に commit される

# Supabase（必須）
# Supabase ダッシュボード → Settings → API から取得
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>

# service_role: サーバー側のみ。RLS を無視できる強権キー。クライアントには絶対に渡さない
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-secret-key>

# Anthropic（Claude Opus 4.7）— LLM の本体
# https://console.anthropic.com/settings/keys から取得
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# OpenAI（TTS 用）
# https://platform.openai.com/api-keys から取得
OPENAI_API_KEY=<your-openai-api-key>
