# 実際の値を入れた .env.local を web/ 直下に作成して使う（.gitignore で除外済み）
# このファイルはテンプレートとして git に commit される

# Supabase（必須）
# Supabase ダッシュボード → Settings → API から取得
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>

# service_role: サーバー側のみ。RLS を無視できる強権キー。クライアントには絶対に渡さない
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-secret-key>

# Anthropic（Claude Opus 4.8）— LLM の本体
# https://console.anthropic.com/settings/keys から取得
# 注: 標準名 ANTHROPIC_API_KEY は Claude Code 等の親 harness が空文字列を inject するため、
# Next.js dotenv の「既存 env 非上書き」規律で読まれない。AI_EDU_ プレフィックスで衝突回避。
AI_EDU_ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Phase 6 smoke test feature flag
# true  → 「計画立てよう」入口のゆい応答を Claude Opus 4.8 で生成
# false → 既存 mock 文言 (フォールバック)
# 値の変更後は dev server を再起動
NEXT_PUBLIC_USE_CLAUDE_API=true

# OpenAI（TTS 用）
# https://platform.openai.com/api-keys から取得
OPENAI_API_KEY=<your-openai-api-key>
